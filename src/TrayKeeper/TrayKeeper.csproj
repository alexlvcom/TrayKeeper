<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TrayKeeper</RootNamespace>
    <AssemblyName>TrayKeeper</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Marketing version: bump the first three parts when Changelog.cs gains an entry. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <!-- Wildcard build/revision auto-changes on every build (needs Deterministic=false),
         so the About window shows a distinct version per build. -->
    <AssemblyVersion>1.1.*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <!-- CS7035: the wildcard above is deliberate, so silence the "recommended format" advice
         rather than letting TreatWarningsAsErrors fail the build on it. -->
    <NoWarn>$(NoWarn);CS7035</NoWarn>
    <!-- Must be pinned: without it the SDK derives FileVersion from AssemblyVersion and the
         literal "1.1.*" ends up in the Win32 version resource. -->
    <FileVersion>1.1.0.0</FileVersion>
    <Product>TrayKeeper</Product>
    <Authors>Alex LV</Authors>
    <Company>Alex LV</Company>
    <Copyright>Copyright © 2026 Alex LV</Copyright>
    <Description>Re-enables tray icons that Windows hid after an application update.</Description>
    <DebugType>embedded</DebugType>

    <!-- Idle cost: the app is purely event driven, so a non-concurrent
         workstation GC keeps the resident set and background threads minimal. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\app.ico" />
  </ItemGroup>

</Project>
