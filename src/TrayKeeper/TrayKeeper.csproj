<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TrayKeeper</RootNamespace>
    <AssemblyName>TrayKeeper</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <InformationalVersion>1.3.1</InformationalVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The name people read. The assembly, the folder and the Run-key value stay one word;
         see AppInfo.cs. -->
    <Product>Tray Keeper</Product>
    <AssemblyTitle>Tray Keeper</AssemblyTitle>
    <Authors>Alex LV</Authors>
    <Company>Alex LV</Company>
    <Copyright>Copyright © 2026 Alex LV</Copyright>
    <Description>Re-enables tray icons that Windows hid after an application update.</Description>
    <DebugType>embedded</DebugType>

    <!-- Idle cost: the app only works on a UI event or a once-a-minute timer tick, so a
         non-concurrent workstation GC keeps the resident set and background threads minimal. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
