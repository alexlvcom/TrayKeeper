<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WinForms hosts the tray icon and the message loop; every window is WPF with the shared
         AlexLV.WindowsUi kit (see AlexLV.WindowsUi/README.md). -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TrayKeeper</RootNamespace>
    <AssemblyName>TrayKeeper</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <InformationalVersion>1.4.0</InformationalVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The name people read. The assembly, the folder and the Run-key value stay one word;
         see AppInfo.cs. -->
    <Product>Tray Keeper</Product>
    <AssemblyTitle>Tray Keeper</AssemblyTitle>
    <Authors>Alex LV</Authors>
    <Company>Alex LV</Company>
    <Copyright>Copyright © 2026 Alex LV</Copyright>
    <Description>Re-enables tray icons that Windows hid after an application update.</Description>
    <DebugType>embedded</DebugType>

    <!-- Idle cost: the app only works on a UI event or a once-a-minute timer tick, so a
         non-concurrent workstation GC keeps the resident set and background threads minimal. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- WPF text layout creates real cultures (for example "en") when it measures fonts; invariant
         globalization makes the first TextBox throw and crash the app. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share type names (Button, TextBox, Application); WPF files opt in to
         WinForms explicitly instead of through implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- UseWPF drops these to avoid System.Windows.Shapes.Path; no file here imports Shapes. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrayKeeper.Tests" />
  </ItemGroup>
</Project>
