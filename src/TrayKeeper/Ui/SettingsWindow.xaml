<ui:ThemedWindow x:Class="TrayKeeper.Ui.SettingsWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="720" Height="660" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <!-- Fixed size; no tab scrolls (windows-apps-common-standards.md, Sectioned Settings). -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
          <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="DirtyText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs">
      <!-- Preferences -->
      <TabItem Header="Preferences" x:Name="PreferencesTab">
        <StackPanel>
          <TextBlock Text="STARTUP" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent" x:Name="StartWithWindowsRow">
                <DockPanel>
                  <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start Tray Keeper with Windows"/>
                    <TextBlock Text="Adds a sign-in entry that targets the installed app." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="RefreshOnStart" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Run refresh when Tray Keeper starts"/>
                    <TextBlock Text="Scans for hidden duplicate tray icons right after launch." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="AUTO-REFRESH" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="AutoRefresh" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Auto-refresh periodically while Tray Keeper runs"/>
                    <TextBlock Text="Quiet unless a refresh actually enables an icon." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" x:Name="IntervalRow" Padding="68,10,16,10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBox x:Name="Interval" Width="76" HorizontalContentAlignment="Right"/>
                      <TextBlock Text="minutes" Style="{StaticResource MutedText}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="IntervalLabel" Text="Auto-refresh interval"/>
                    <TextBlock x:Name="IntervalError" Text="Enter a whole number from 1 to 1440." Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource FirstCardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="Balloons" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <TextBlock Text="Show balloon notifications after refresh restores icons" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardRow}" MouseLeftButtonUp="Row_Click" Background="Transparent">
                <DockPanel>
                  <CheckBox x:Name="SkipMissing" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                  <TextBlock Text="Leave entries alone when their executable is confirmed missing" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Appearance -->
      <TabItem Header="Appearance" x:Name="AppearanceTab">
        <StackPanel>
          <TextBlock Text="Choose how Tray Keeper's windows look. The change previews right away; Save keeps it." Style="{StaticResource LeadText}"/>
          <TextBlock Text="THEME" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <Border Style="{StaticResource FirstCardRow}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Theme"/>
                  <TextBlock Text="System follows the Windows light or dark setting." Style="{StaticResource MutedText}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Updates -->
      <TabItem Header="Updates" x:Name="UpdatesTab">
        <StackPanel>
          <TextBlock Text="Choose when Tray Keeper checks GitHub for newer releases and updates." Style="{StaticResource LeadText}"/>
          <Border Style="{StaticResource Card}" Padding="16">
            <DockPanel>
              <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="Update" Style="{StaticResource PrimaryButton}"
                      VerticalAlignment="Center" Visibility="Collapsed" Click="InstallUpdate_Click"/>
              <Ellipse x:Name="UpdateDot" Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
              <StackPanel>
                <TextBlock x:Name="UpdateTitle" Style="{StaticResource StrongText}"/>
                <TextBlock x:Name="UpdateDetail" Style="{StaticResource MutedText}" FontSize="14"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Check for updates" VerticalAlignment="Center" MinWidth="132"/>
              <ComboBox x:Name="Frequency" Margin="10,0,10,0">
                <ComboBoxItem Content="Once an hour"/>
                <ComboBoxItem Content="Once a day (default)"/>
                <ComboBoxItem Content="Once a week"/>
                <ComboBoxItem Content="Once a month"/>
                <ComboBoxItem Content="Never"/>
              </ComboBox>
              <Button x:Name="CheckNowButton" Content="Check for updates" Click="CheckNow_Click"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Reliable automated updates" Style="{StaticResource StrongText}" Margin="0,0,0,2"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14"
                         Text="Setup installers are downloaded from official GitHub releases and verified with SHA-256 before running. Scheduled background checks stay quiet and never interrupt icon management."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- About -->
      <TabItem Header="About" x:Name="AboutTab">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="AboutTitle" Style="{StaticResource TitleText}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14">
                <Run x:Name="AboutBuild"/>
                <Hyperlink x:Name="RepoLink" Click="Repo_Click">github.com/alexlvcom/TrayKeeper</Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="NotesHeader" Style="{StaticResource StrongText}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource Card}" Height="210">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10" Focusable="False">
              <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
          </Border>
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Copy details" Click="CopyDetails_Click"/>
            <Button Style="{StaticResource LinkButton}" Content="View full change history" Click="History_Click" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </DockPanel>
        </StackPanel>
      </TabItem>

      <!-- Diagnostics -->
      <TabItem Header="Diagnostics" x:Name="DiagnosticsTab">
        <StackPanel>
          <TextBlock Text="Where Tray Keeper runs from and keeps its settings, registry backups and logs." Style="{StaticResource LeadText}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="PathsPanel"/>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</ui:ThemedWindow>
