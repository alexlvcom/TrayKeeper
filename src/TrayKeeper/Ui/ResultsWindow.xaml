<Window x:Class="TrayKeeper.Ui.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="820" Height="600" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Content="Refresh now" Click="Refresh_Click"/>
          <Button x:Name="CloseButton" Content="Close" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RestoreButton" Content="Restore last changes" Click="Restore_Click"/>
          <Button Content="Open log folder" Margin="8,0,0,0" Click="OpenLog_Click"/>
          <Button Content="Restart Explorer" Margin="8,0,0,0" Click="RestartExplorer_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- A report window, not Settings: its body may scroll. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="Body" Margin="24,22"/>
    </ScrollViewer>
  </DockPanel>
</Window>
